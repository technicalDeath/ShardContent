<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ModernUOPath Condition="'$(ModernUOPath)' == ''">$(MSBuildThisFileDirectory)..\..\ModernUO</ModernUOPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="scenarios/**/*.cs" />
    <Compile Remove="scenarios/**/bin/**/*.cs;scenarios/**/obj/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" PrivateAssets="all" />
    <ProjectReference Include="..\src\BritanniaRenaissance.Content\BritanniaRenaissance.Content.csproj" />
    <Reference Include="Server">
      <HintPath>$(ModernUOPath)\Distribution\Server.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UOContent">
      <HintPath>$(ModernUOPath)\Distribution\Assemblies\UOContent.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Logger">
      <HintPath>$(ModernUOPath)\Distribution\Assemblies\Logger.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
